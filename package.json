{
  "name": "iiko-cloud-sdk",
  "version": "0.0.0",
  "description": "Unofficial TypeScript SDK for the iikoCloud API: typed requests, JWT auth, retries and typed errors.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.21.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "iiko",
    "iikocloud",
    "sdk",
    "typescript"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests examples scripts",
    "format": "oxfmt src tests examples scripts",
    "format:check": "oxfmt --check src tests examples scripts",
    "test": "vitest run --coverage",
    "iiko:download": "curl -sS -L https://api-ru.iiko.services/api-docs/docs -o src/generated/openapi.json",
    "iiko:types": "openapi-typescript src/generated/openapi.json -o src/generated/schema.ts",
    "iiko:sync": "pnpm iiko:download && pnpm iiko:types && pnpm iiko:operations",
    "iiko:operations": "node scripts/generate/operations.mjs",
    "changeset": "changeset",
    "live:check": "node scripts/live-check.mjs"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^5.1.1",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.1"
  }
}
