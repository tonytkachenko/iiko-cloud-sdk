{
  "name": "iiko-cloud-sdk",
  "version": "0.3.0",
  "description": "Unofficial TypeScript SDK for the iikoCloud API: typed requests, JWT auth, retries and typed errors.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.21.0",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "iiko",
    "iikocloud",
    "iiko-cloud",
    "restaurant",
    "pos",
    "sdk",
    "typescript"
  ],
  "scripts": {
    "build": "tsup && node -e \"require('node:fs').rmSync('dist/index.d.cts',{force:true})\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests examples scripts",
    "format": "oxfmt src tests examples scripts",
    "format:check": "oxfmt --check src tests examples scripts",
    "test": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm test",
    "spec:download": "curl -sS -L https://api-ru.iiko.services/api-docs/docs -o spec/raw.json",
    "spec:normalize": "node scripts/normalize-spec.mjs",
    "spec:types": "openapi-typescript spec/normalized.json -o src/generated/schema.ts",
    "spec:generate": "node scripts/generate.mjs",
    "spec:build": "pnpm spec:normalize && pnpm spec:types && pnpm spec:generate",
    "spec:sync": "pnpm spec:download && pnpm spec:build",
    "changeset": "changeset",
    "live:check": "node scripts/live-check.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26",
    "@vitest/coverage-v8": "^5.1.2",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.2"
  },
  "author": "Tony Tkachenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonytkachenko/iiko-cloud-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/tonytkachenko/iiko-cloud-sdk/issues"
  },
  "homepage": "https://github.com/tonytkachenko/iiko-cloud-sdk#readme",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  }
}
