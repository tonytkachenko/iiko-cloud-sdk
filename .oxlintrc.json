{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "import",
    "unicorn",
    "oxc",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    "src/generated/**",
    "dist/**",
    "coverage/**",
    "src/transport/generated/**",
    "src/office/generated/**"
  ],
  "rules": {
    "no-await-in-loop": "off"
  }
}
